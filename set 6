import java.awt.*; 
import java.io.*; 
import java.util.*; 
import javax.swing.*; 
 
public class LabelsInGridLayout { 
    public static void main(String[] args) { 
        JFrame f=new JFrame("FILE READING EXAMPLE"); 
 
        try { 
            Scanner st=new Scanner(new FileReader("Employee.txt")); 
 
            while(st.hasNext()) { 
                f.add(new JLabel(st.next())); 
                f.setLayout(new GridLayout(4,2)); 
                f.setSize(400,200); 
                f.setVisible(true); 
            } 
        } 
        catch(Exception ex) { 
            System.out.println("Error reading file"); 
} 
f.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE); 
} 
} 


