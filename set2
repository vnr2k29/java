class Account {
    String holderName;
    String accountType;
    double balance;

    Account() {
        holderName = "Unknown";
        accountType = "Savings";
        balance = 500.0;
    }

    Account(String holderName, String accountType, double balance) {
        this.holderName = holderName;
        this.accountType = accountType;
        this.balance = balance;
    }

    void displayAccountInfo() {
        System.out.println("Holder: " + holderName +
            " | Type: " + accountType +
            " | Balance: $" + balance);
    }
}

public class Main {
    public static void main(String[] args) {
        Account acc1 = new Account();
        Account acc2 = new Account("Alice Smith", "Current", 25000.50);

        System.out.println("--- Account Details ---");

        acc1.displayAccountInfo();
        acc2.displayAccountInfo();
    }
}
